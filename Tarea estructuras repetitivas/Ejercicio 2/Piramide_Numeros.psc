Algoritmo Piramide_Numeros
	
    Definir n, i, j Como Entero
	
    Escribir "Ingrese el numero de lineas: "
    Leer n
	
    Para i <- 1 Hasta n Hacer
		
        Para j <- 1 Hasta i Hacer
            Escribir Sin Saltar j, " "
        FinPara
		
        Escribir ""
		
    FinPara
	
FinAlgoritmo